version: v3
teleport:
  nodename: {{ teleport_node_name }}
  data_dir: /var/lib/teleport
  proxy_server: "{{ teleport_proxy_addr }}"
  join_params:
    token_name: "{{ teleport_auth_token }}"
    method: token
  log:
    output: stderr
    severity: INFO
auth_service:
  enabled: false
proxy_service:
  enabled: false
ssh_service:
  enabled: true
  labels:
{% if teleport_labels %}
{% for key, value in teleport_labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
    hostname: "{{ inventory_hostname }}"
  commands:
    - name: hostname
      command: [/bin/hostname]
      period: 1m0s